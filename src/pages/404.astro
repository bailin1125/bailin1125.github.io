---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面不存在" description="404">
  <section class="py-28 text-center">
    <p class="font-mono text-6xl font-bold tracking-tight text-accent">404</p>
    <p class="mt-5 text-muted">这个页面不存在，可能被我删掉了。</p>
    <div class="mt-8 flex items-center justify-center gap-6 text-sm">
      <a href="/" class="text-accent hover:underline">← 回首页</a>
      <span class="text-line">|</span>
      <a href="/products" class="text-muted hover:text-ink">看看产品</a>
    </div>
  </section>
</BaseLayout>
