---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostItem from '../components/PostItem.astro';
import { SITE } from '../config';

const projects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---
<BaseLayout>
  <!-- Hero -->
  <section class="py-20">
    <h1 class="text-4xl font-bold tracking-tight text-ink">{SITE.name}</h1>
    <p class="mt-4 text-lg text-muted">{SITE.tagline}</p>
    <div class="mt-8 flex flex-wrap items-center gap-4 text-sm">
      <a href="#products" class="rounded-lg border border-accent px-4 py-2 text-accent transition-colors hover:bg-surface">看产品 →</a>
      <a href={SITE.github} target="_blank" rel="noopener" class="text-accent hover:underline">GitHub</a>
      <a href={`mailto:${SITE.email}`} class="text-accent hover:underline">发邮件给我</a>
    </div>
  </section>

  <!-- 产品精选 -->
  {projects.length > 0 && (
    <section id="products" class="py-10">
      <div class="flex items-baseline justify-between">
        <h2 class="text-lg font-semibold text-ink">产品</h2>
        <a href="/products" class="text-sm text-accent hover:underline">全部 →</a>
      </div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  )}

  <!-- 关于我 -->
  <section class="py-10">
    <h2 class="text-lg font-semibold text-ink">关于我</h2>
    <p class="mt-3 text-sm leading-7 text-muted">
      白天写代码，晚上写字。喜欢把重复的事情自动化，把复杂的问题拆简单；相信好的工具应该安静好用，好的文字应该诚实地记录。
    </p>
    <p class="mt-2 text-sm leading-7 text-muted">
      折腾过命令行工具、静态站点和一点点数据可视化；最近在琢磨怎么把写作和发布变成同一条流水线。
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      {['命令行', '自动化', '静态站点', '写作'].map((t) => (
        <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{t}</span>
      ))}
    </div>
  </section>


  <!-- 最新文章 -->
  <section class="py-10">
    <div class="flex items-baseline justify-between">
      <h2 class="text-lg font-semibold text-ink">最新文章</h2>
      <a href="/blog" class="text-sm text-accent hover:underline">全部 →</a>
    </div>
    <div class="mt-3">
      {posts.map((p) => <PostItem post={p} />)}
    </div>
  </section>

  <!-- 联系 -->
  <section class="py-10 pb-20">
    <h2 class="text-lg font-semibold text-ink">找到我</h2>
    <p class="mt-3 text-sm text-muted">
      邮箱 <a href={`mailto:${SITE.email}`} class="text-accent hover:underline">{SITE.email}</a>，
      或到 <a href={SITE.github} target="_blank" rel="noopener" class="text-accent hover:underline">GitHub</a> 逛逛。
    </p>
  </section>
</BaseLayout>
