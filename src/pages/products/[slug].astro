---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, description, status, longText, features, url, repo, tech, image } = project.data;
const initials = title.replace(/[^A-Za-z\u4e00-\u9fff]/g, '').slice(0, 2).toUpperCase();
---
<BaseLayout title={title} description={description} image={image}>
  <article class="py-12">
    <header class="border-b border-line pb-6">
      <a href="/products" class="text-xs text-muted transition-colors hover:text-ink">← 产品</a>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-ink">{title}</h1>
        <StatusBadge status={status} />
      </div>
      <p class="mt-3 text-sm text-muted">{description}</p>
    </header>

    <div class="py-8">
      <div class="overflow-hidden rounded-lg border border-line bg-bg">
        {image ? (
          <img src={image} alt={title} class="w-full object-cover" width="1200" height="750" />
        ) : (
          <div class="flex aspect-[16/10] w-full items-center justify-center">
            <span class="select-none font-mono text-4xl font-bold tracking-widest text-muted/50">{initials}</span>
          </div>
        )}
      </div>

      {longText && <p class="mt-8 leading-7 text-ink">{longText}</p>}

      {features.length > 0 && (
        <section class="mt-8">
          <h2 class="mb-3 text-lg font-semibold text-ink">亮点</h2>
          <ul class="list-disc pl-6 leading-7 text-ink">
            {features.map((f) => <li>{f}</li>)}
          </ul>
        </section>
      )}

      {(url || repo) && (
        <section class="mt-8 flex flex-wrap gap-4 text-sm">
          {url && (
            <a href={url} target="_blank" rel="noopener" class="rounded-lg border border-accent px-4 py-2 text-accent transition-colors hover:bg-surface">
              在线使用 ↗
            </a>
          )}
          {repo && (
            <a href={repo} target="_blank" rel="noopener" class="rounded-lg border border-line px-4 py-2 text-muted transition-colors hover:border-accent hover:text-accent">
              源码 ↗
            </a>
          )}
        </section>
      )}

      {tech.length > 0 && (
        <section class="mt-8">
          <h2 class="mb-3 text-lg font-semibold text-ink">技术栈</h2>
          <div class="flex flex-wrap gap-2">
            {tech.map((t) => (
              <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{t}</span>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
