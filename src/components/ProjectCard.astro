---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { title, description, status, tech, image } = project.data;
const initials = title.replace(/[^A-Za-z\u4e00-\u9fff]/g, '').slice(0, 2).toUpperCase();
---
<a
  href={`/products/${project.id}/`}
  class="group flex h-full flex-col overflow-hidden rounded-lg border border-line bg-surface transition-colors hover:border-accent"
>
  <div class="relative aspect-[16/10] shrink-0 overflow-hidden border-b border-line bg-bg">
    {image ? (
      <img
        src={image}
        alt={title}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        loading="lazy"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center">
        <span class="select-none font-mono text-2xl font-bold tracking-widest text-muted/50">{initials}</span>
      </div>
    )}
  </div>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center justify-between gap-3">
      <h3 class="font-semibold text-ink transition-colors group-hover:text-accent">{title}</h3>
      <StatusBadge status={status} />
    </div>
    <p class="mt-2 text-sm text-muted">{description}</p>
    {tech.length > 0 && <p class="mt-auto pt-3 text-xs text-muted">{tech.join(' · ')}</p>}
  </div>
</a>
